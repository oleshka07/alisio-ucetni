# Vercel Postgres — копіюється автоматично після підключення в Vercel Dashboard
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://...?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://..."

# Використовується Prisma
DATABASE_URL="$POSTGRES_PRISMA_URL"

# Auth — пароль для входу бухгалтера
AUTH_PASSWORD="your-secure-password-here"
AUTH_SECRET="random-secret-for-token-signing"

# Vercel Blob — для збереження файлів
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
