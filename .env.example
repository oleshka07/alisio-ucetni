# ─── Alisio Účetnictví — змінні середовища (Hetzner) ───────────────────────────
# Файл: /root/projects/alisio-ucetni/.env   (права: chmod 600 .env)
# Секрети генерувати так:  openssl rand -hex 32

# База (Postgres на тому ж сервері)
POSTGRES_PRISMA_URL="postgresql://alisio_ucetni:ПАРОЛЬ_БД@127.0.0.1:5432/alisio_ucetni"
POSTGRES_URL_NON_POOLING="postgresql://alisio_ucetni:ПАРОЛЬ_БД@127.0.0.1:5432/alisio_ucetni"

# Адреса застосунку (для посилань у Telegram і webhook)
APP_URL="https://ucetni.rozum.one"

# Сесії (мін. 32 символи) і шифрування паролів скриньок (рівно 64 hex)
AUTH_SECRET="openssl rand -hex 32"
ENCRYPTION_KEY="openssl rand -hex 32"

# Перший вхід власника: працює лише поки в базі немає жодного користувача
BOOTSTRAP_OWNER_EMAIL="o.stepeniev@swipescape.eu"
BOOTSTRAP_OWNER_PASSWORD="тимчасовий-пароль-мінімум-12-символів"

# Фонові задачі (crontab викликає /api/cron/* з цим ключем)
CRON_SECRET="openssl rand -hex 32"

# Файли документів (без BLOB_READ_WRITE_TOKEN — локальний диск)
FILES_DIR="/var/lib/alisio-ucetni/files"

# AI-розпізнавання документів
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Telegram (окремий бот від @kemptimebot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET="openssl rand -hex 32"

# Часовий пояс для дат і розкладу
TZ="Europe/Prague"
